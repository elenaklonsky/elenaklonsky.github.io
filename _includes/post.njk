---
layout: base.njk
---

<main class="container">
  <article class="card card--writing">
    <a class="writing-back" href="../../thinking/">back to thinking</a>

    <div class="inner inner--writing">
      <h1>{{ title }}</h1>

      <div class="bio writing-body">
        {{ content | safe }}
      </div>
    </div>
  </article>
</main>

<script>
  (() => {
    const root = document.documentElement;
    const writingBody = document.querySelector(".writing-body");

    if (!writingBody || window.matchMedia("(max-width: 700px)").matches) return;

    const startOffset = 88;
    const minOffset = 0;
    const cardSpeed = 0.45;
    const textSpeed = 0.30;

    let cardOffset = startOffset;
    root.style.setProperty("--writing-card-offset", `${cardOffset}px`);

    function setCardOffset(value) {
      cardOffset = Math.max(minOffset, Math.min(startOffset, value));
      root.style.setProperty("--writing-card-offset", `${cardOffset}px`);
    }

    function onWheel(event) {
      event.preventDefault();

      const goingDown = event.deltaY > 0;
      const goingUp = event.deltaY < 0;

      const atTopOfText = writingBody.scrollTop <= 0;
      const atBottomOfText =
        writingBody.scrollTop + writingBody.clientHeight >= writingBody.scrollHeight - 1;

      if (goingDown && cardOffset > minOffset) {
        setCardOffset(cardOffset - event.deltaY * cardSpeed);
        return;
      }

      if (goingDown && !atBottomOfText) {
        writingBody.scrollTop += event.deltaY * textSpeed;
        return;
      }

      if (goingUp && !atTopOfText) {
        writingBody.scrollTop += event.deltaY * textSpeed;
        return;
      }

      if (goingUp && atTopOfText && cardOffset < startOffset) {
        setCardOffset(cardOffset - event.deltaY * cardSpeed);
      }
    }

    window.addEventListener("wheel", onWheel, { passive: false });
  })();
</script>
