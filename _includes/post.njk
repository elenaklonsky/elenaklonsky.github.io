---
layout: base.njk
---

<main class="container">
  <article class="card card--writing">
    <a class="writing-back" href="../../thinking/">back to thinking</a>

    <div class="inner inner--writing">
      <h1>{{ title }}</h1>

      <div class="bio writing-body">
        {{ content | safe }}
      </div>
    </div>
  </article>
</main>

<script>
  (() => {
    const card = document.querySelector(".card--writing");
    const writingBody = document.querySelector(".writing-body");

    if (!card || !writingBody || window.matchMedia("(max-width: 700px)").matches) return;

    const stickyTop = 0;
    const scrollSpeed = 0.55;

    writingBody.addEventListener("wheel", (event) => {
      const cardTop = card.getBoundingClientRect().top;
      const cardHasNotReachedTop = cardTop > stickyTop + 1;

      if (cardHasNotReachedTop && event.deltaY > 0) {
        event.preventDefault();
        window.scrollBy({
          top: event.deltaY,
          left: 0
        });
        return;
      }

      const atTop = writingBody.scrollTop <= 0;
      const atBottom =
        writingBody.scrollTop + writingBody.clientHeight >= writingBody.scrollHeight - 1;

      if (event.deltaY < 0 && atTop) {
        event.preventDefault();
        window.scrollBy({
          top: event.deltaY,
          left: 0
        });
        return;
      }

      if (event.deltaY > 0 && !atBottom) {
        event.preventDefault();
        writingBody.scrollTop += event.deltaY * scrollSpeed;
        return;
      }

      if (event.deltaY < 0 && !atTop) {
        event.preventDefault();
        writingBody.scrollTop += event.deltaY * scrollSpeed;
      }
    }, { passive: false });
  })();
</script>
