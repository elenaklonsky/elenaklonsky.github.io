---
layout: base.njk
title: thinking
permalink: /thinking/
---

<main class="container">
  <article class="card card--thinking">
    <div class="inner inner--thinking">
      <h1>thinking</h1>

      <div class="bio thinking-intro">
        writing and notes
      </div>

      <ul class="writing-list">
        {% for post in collections.writing | reverse %}
          <li class="writing-list__item">
            <a class="writing-list__link" href="{{ post.url | url }}">
              <span class="writing-list__title">{{ post.data.title }}</span>
              {% if post.data.date %}
                <span class="writing-list__date">{{ post.data.date | readableDate }}</span>
              {% endif %}
            </a>
          </li>
        {% else %}
          <li class="writing-list__empty">no writing published yet.</li>
        {% endfor %}
      </ul>
    </div>

    <div class="buttons buttons--single">
      <a class="btn work" href="../">back to home</a>
    </div>
  </article>
</main>
